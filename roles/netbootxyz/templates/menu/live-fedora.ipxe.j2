#!ipxe

isset ${dhcp-server} && set ipparam ip=dhcp || set ipparam ip=${ip}::${gateway}:${netmask}:::none nameserver=${dns}
set ipparam BOOTIF=${netX/mac} ${ipparam}

goto ${menu} ||

:live_menu
set os Fedora Live
menu ${os}
item --gap ${os} Versions
item 44 ${space} ${os} 44
item 43 ${space} ${os} 43
item 42 ${space} ${os} 42
item 41 ${space} ${os} 41
item 40 ${space} ${os} 40

choose live_version || goto live_exit
menu ${os} ${live_version}
item --gap ${os} Flavors
goto ${live_version}
:44
set repo https://archive.org/download/Fedora-Workstation-Live-x86_64-44-1.7.x86_64/
kernel ${repo}/linux \
    ip=dhcp \
    rd.neednet=1 \
    rd.live.image \
    root=live:${repo}/squashfs.img \
    initrd=initrd
initrd ${repo}/initrd
boot
:43
goto flavor_select
:42
goto flavor_select
:41
goto flavor_select
:40
set repo https://github.com/gyttyfgyfytttfc/netboot.xyz/releases/download/Fedora-Workstation-Live-x86_64-40-1.14/
kernel ${repo}/vmlinuz \
    ip=dhcp \
    rd.neednet=1 \
    rd.live.image \
    root=live:${repo}/squashfs.img \
    initrd=initrd
initrd ${repo}/initrd.img
boot

:flavor_select
choose flavor || goto live_menu
echo ${cls}
goto ${flavor} ||

:fedora-40-gnome
set live_url ${live_endpoint}/fedora-assets/releases/download/1.14-aefc8f89/
goto boot

:boot
imgfree
kernel ${live_url}vmlinuz ${ipparam} root=live:${live_url}squashfs.img ro rd.live.image rd.lvm=0 rd.luks=0 rd.md=0 rd.dm=0 initrd=initrd.magic ${cmdline}
initrd ${live_url}initrd
boot

:live_exit
clear menu
exit 0
